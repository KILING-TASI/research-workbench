{
  "registryVersion": "optional-engine-contracts-v1",
  "engines": [
    {
      "id": "lookthrough",
      "repository": "cn-fund-lookthrough",
      "module": "cnlookthrough",
      "inputSchema": "cnlookthrough-nodes-v1",
      "rulesVersion": "disclosed-paths-1",
      "optional": true,
      "bridgeAvailable": true,
      "defaultReplacement": false,
      "unsupported": [
        "automatic issuer resolution",
        "leverage over 100%",
        "arbitrary PDF"
      ]
    },
    {
      "id": "financial",
      "repository": "cn-financial-reconcile",
      "module": "cnreconcile",
      "inputSchema": "cnreconcile-pairs-v1",
      "rulesVersion": "amount-dimensions-1",
      "optional": true,
      "bridgeAvailable": true,
      "defaultReplacement": false,
      "unsupported": [
        "all financial statement extraction",
        "audit opinions",
        "automatic restatement priority"
      ]
    },
    {
      "id": "fund-report-ruiyuan",
      "repository": "cn-fund-lookthrough",
      "module": "cnlookthrough.report_cli",
      "inputSchema": "explicit-report-totals-v1",
      "rulesVersion": "six-column-equity-1",
      "optional": true,
      "bridgeAvailable": true,
      "defaultReplacement": false,
      "equivalenceScope": "007119 complete six-column interim/annual equity, explicit CNY NAV and equity totals"
    },
    {
      "id": "portfolio",
      "repository": "portfolio-decision-engine",
      "bridgeAvailable": false,
      "defaultReplacement": false,
      "status": "contract-and-equivalence-pending"
    },
    {
      "id": "bjx",
      "repository": "bjx-ipo-engine",
      "bridgeAvailable": false,
      "defaultReplacement": false,
      "status": "contract-and-equivalence-pending"
    },
    {
      "id": "convertible",
      "repository": "convertible-bond-engine",
      "bridgeAvailable": false,
      "defaultReplacement": false,
      "status": "contract-and-equivalence-pending"
    }
  ],
  "failureStates": [
    "entry-unavailable",
    "input-or-basis-invalid",
    "execution-failed-or-timeout",
    "output-identity-or-version-invalid"
  ],
  "sharedFormats": [
    "entity and units",
    "report/published/acquired/valuation dates",
    "source hash and version",
    "unknown scope",
    "input snapshot and result manifest"
  ],
  "autoDownload": false,
  "forcedInstall": false,
  "privateDirectoryScan": false
}